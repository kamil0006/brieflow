# Copy to .env and fill in real values — this file is safe to commit
# because it contains no secrets.

DATABASE_URL="file:./prisma/dev.db"

# Key for classifying/scoring news (OpenAI)
OPENAI_API_KEY=""

# Optional: use a model other than the default gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"

# Key for signing login sessions — generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Cost limits (protect your OpenAI bill) ---

# Comma-separated emails allowed to create an account. Leave empty for open
# sign-up — but anyone with an account can spend your OpenAI credits, so set
# this before putting the app online.
SIGNUP_ALLOWED_EMAILS=""

# Most accounts the app allows in total — anyone can sign up with their own
# email until this many exist. Unset or 0 = no cap.
# MAX_ACCOUNTS=2

# Minutes each account waits between two successful "Fetch new news" runs
# SCRAPE_COOLDOWN_MINUTES=5

# Most "Fetch new news" runs per account per hour (failed ones count too).
# 0 = no cap
# SCRAPE_LIMIT_PER_HOUR=5

# Chat questions per account per hour
# ASK_LIMIT_PER_HOUR=30

# New AI key point summaries per account per hour (stored ones are free)
# KEY_POINTS_LIMIT_PER_HOUR=60

# --- Storage ---

# Days to keep news before it's deleted on the next refresh. Saved articles
# and ones someone actually opened (History) are always kept.
# ARTICLE_RETENTION_DAYS=30

# Comma-separated emails of the app owner(s). Only they see the AI cost
# overview in Settings. Leave empty to show it to nobody.
ADMIN_EMAILS=
# Optional: USD per 1M tokens, overrides the built-in price list
# (src/lib/aiUsage.ts) — for a model it doesn't know or after a price change.
# AI_PRICE_INPUT_PER_M=
# AI_PRICE_OUTPUT_PER_M=
