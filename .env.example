# Copy to .env and fill in real values — this file is safe to commit
# because it contains no secrets.

DATABASE_URL="file:./prisma/dev.db"

# Key for classifying/scoring news (OpenAI)
OPENAI_API_KEY=""

# Optional: use a model other than the default gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"

# Key for signing login sessions — generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Cost limits (protect your OpenAI bill) ---

# Comma-separated emails allowed to create an account. Leave empty for open
# sign-up — but anyone with an account can spend your OpenAI credits, so set
# this before putting the app online.
SIGNUP_ALLOWED_EMAILS=""

# Minutes each account waits between two successful "Fetch new news" runs
# SCRAPE_COOLDOWN_MINUTES=5

# Chat questions per account per hour
# ASK_LIMIT_PER_HOUR=30

# New AI key point summaries per account per hour (stored ones are free)
# KEY_POINTS_LIMIT_PER_HOUR=60
